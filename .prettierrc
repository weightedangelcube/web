{
	"arrowParens": "always",
	"semi": false,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "none",
	"printWidth": 120,
	"tabWidth": 4,
	"useTabs": true,
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		}
	]
}
