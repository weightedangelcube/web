---
import "../../styles/logbook.scss"
import { getCollection, render } from "astro:content"
import { Temporal } from "temporal-polyfill"
import Header from "../../components/Header.astro"

const sortDate = (a: any, b: any) => Temporal.PlainDate.compare(b.data.published_date, a.data.published_date)

const entries = await getCollection("logbook")

const collections = entries
	.filter((entry) => entry.data.collection)
	.sort(sortDate)
	.reverse()
	.reduce(
		(acc, entry) => {
			const collection = entry.data.collection!
			if (!acc[collection]) acc[collection] = []
			acc[collection].push(entry)
			return acc
		},
		{} as Record<string, typeof entries>
	)

const misc = entries.filter((entry) => !entry.data.collection).sort(sortDate)
---

<!DOCTYPE html>
<html lang="en-CA">
	<head>
		<!-- Important metadata, and the like -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width = device-width, initial-scale = 1" />
		<title>logbook · angelcube</title>

		<!-- Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
	</head>

	<body>
		<main>
			<Header title="logbook →" description="Infinite grief fountain." />
			<!-- <p class="warning">
				<strong>Tread lightly—</strong>much of my poetry deals in themes such as love, loss, and other brave
				forms of darkness. Check in with yourself, then go forth and touch faith—
			</p> -->
			<section class="posts">
				<ul class="post-list">
					{misc.map((post: any) => {
						switch (post.data.type) {
							case "text":
								return (
						   <li>
							   <span class="post-title">
								   <a href={`/logbook/${post.id}`}>{post.data.title}</a>
							   </span>

							   <span class="published-date">
								   {post.data.published_date.toLocaleString("en-CA", {
								   	year: "numeric",
								   	month: "long",
								   	day: "numeric"
								   })}
							   </span>

							   <span class="post-description">
								   {post.data.description}
							   </span>
						   </li>
					   )
							case "artwork":
								return (
						   <li>
							   <a href={`/logbook/${post.id}`}>
								   <img class="post-artwork" src={post.data.image.src} alt={post.data.alt} />
							   </a>
						   </li>
					   )
						}
					})}
				</ul>
			</section>
			<section class="posts">
				<h2>collections</h2>
				{Object.entries(collections).map(([collectionName, entries]) => (
					<>
						<h3>{collectionName}</h3>

						<ul class="post-list">
							{entries.map((post: any) => {
								switch (post.data.type) {
									case "text":
										return (
								   <li>
									   <span class="post-title">
										   <a href={`/logbook/${post.id}`}>{post.data.title}</a>
									   </span>

									   <span class="published-date">
										   {post.data.published_date.toLocaleString("en-CA", {
										   	year: "numeric",
										   	month: "long",
										   	day: "numeric"
										   })}
									   </span>

									   <span class="post-description">
										   {post.data.description}
									   </span>
								   </li>
							   )
									case "artwork":
										return (
								   <li>
									   <a href={`/logbook/${post.id}`}>
										   <img class="post-artwork" src={post.data.image.src} />
									   </a>
								   </li>
							   )
								}
							})}
						</ul>
					</>
				))}
			</section>
		</main>
	</body>
</html>
