---
import "../../styles/post.scss"
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection("journal")
    return posts.map(post => ({
        params: { id: post.id },
        props: { post },
    }))
}

const { post } = Astro.props;
const { Content } = await render(post)
---

<!doctype html>
<html lang="en-CA">
	<head>
		<!-- Important metadata, and the like -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width = device-width, initial-scale = 1" />
		<title>{post.data.title} · a journal by angelcube</title>

        <!-- Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg">
	</head>

    <body>
        <main>
            <header>
                <nav>
                    <span class="back">
                        <a href="/journal">← back to journal</a>
                    </span>
                    <span class="name">angelcube ✦</span>
                </nav>
                <div class="title">
                    <div class="heading">
                        <span class="type">{post.data.type}</span>
                        <h1>{post.data.title}</h1>
                        <p class="description">{post.data.description}</p>
                    </div>
                    <div class="written-date-meta">
                        <span>Written</span>
                        <span class="date">{post.data.written_date.toLocaleString("en-CA", {year: "numeric", month: "long", day: "numeric"})}</span>
                    </div>
                    <div class="updated-date-meta">
                        <span>Updated</span>
                        <span class="date">{post.data.updated_date.toLocaleString("en-CA", {year: "numeric", month: "long", day: "numeric"})}</span>
                    </div>
                </div>
            </header>
            <article>
                <Content />
            </article>
        </main>
    </body>
</html>