---
import Header from "../../components/Header.astro";
import "../../styles/journal.scss";
import { getCollection } from "astro:content";
import { Temporal } from "temporal-polyfill";

type PostType = "Ramblings" | "Writings";

async function getSortedPosts(type: PostType) {
	return (
		await getCollection("journal", ({ data }) => {
			return data.type === type;
		})
	).sort(
		(a: any, b: any) =>
			Temporal.PlainDate.compare(b.data.published_date, a.data.published_date)
	)
}

const writings = await getSortedPosts("Writings")
const ramblings = await getSortedPosts("Ramblings")
---

<!doctype html>
<html lang="en-CA">
	<head>
		<!-- Important metadata, and the like -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width = device-width, initial-scale = 1" />
		<title>journal · angelcube</title>

		<!-- Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
	</head>

	<body>
		<main>
			<Header title="journal →" description="Words I wanted to say." />
			<p class="warning">
				<strong>Tread lightly—</strong>much of my poetry deals in themes such as love, loss, and other brave
				forms of darkness. Check in with yourself before going on, and touch faith—
			</p>
			<ul class="post-list">
				{writings.map((post: any) => (
					<li>
						<span class="post-title"><a href={`/journal/${post.id}`}>{post.data.title}</a></span>
						<span class="published-date">{post.data.published_date.toLocaleString("en-CA", {year: "numeric", month: "long", day: "numeric"})}</span>
					</li>
				))}
			</ul>
		</main>
	</body>
</html>
