---
import "../../styles/journal.scss";
import { getCollection } from "astro:content";

type PostType = "Ramblings" | "Writings";

async function getSortedPosts(type: PostType) {
	return (
		await getCollection("journal", ({ data }) => {
			return data.type === type;
		})
	).sort(
		(a: any, b: any) =>
			Temporal.PlainDate.compare(b.data.written_date, a.data.written_date)
	)
}

const writings = await getSortedPosts("Writings")
const ramblings = await getSortedPosts("Ramblings")
---

<!doctype html>
<html lang="en-CA">
	<head>
		<!-- Important metadata, and the like -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width = device-width, initial-scale = 1" />
		<title>journal · angelcube</title>

		<!-- Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
	</head>

	<body>
		<main>
		<header>
			<nav>
			<span class="back">
				<a href="/journal">← back to journal</a>
			</span>
			<span class="name">angelcube ✦</span>
			</nav>
		</header>
		<h1>journal →</h1>
		<h2>writings</h2>
		<ul>
			{writings.map((post: any) => (
				<li>
					<a href={`/journal/${post.id}`}>{post.data.title}</a>
				</li>
			))}
		</ul>
		<h2>ramblings</h2>
		<ul>
			{ramblings.map((post: any) => (
				<li>
					<a href={`/journal/${post.id}`}>{post.data.title}</a>
				</li>
			))}
			</ul>
		</main>
	</body>
</html>
