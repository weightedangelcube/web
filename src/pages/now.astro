---
import "../styles/now.scss"
import { Content as Now } from "../../content/now.mdx"
import { Content as NowPrev } from "../../content/now-prev.mdx"
import LBPinned from "../components/preact/LBPinned";
import Header from "../components/Header.astro";
---
<!doctype html>
<html lang="en-CA">
	<head>
		<!-- Important metadata, and the like -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width = device-width, initial-scale = 1" />
		<title>now · angelcube</title>

        <!-- Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg">
	</head>
    <body>
		<main>
			<Header title="now →" description="Recent thoughts, interests, activities." />
			<article>
				<section id="now">
					<Now />
				</section>
				<section id="also">
					<h3>Also</h3>
					<LBPinned client:only="preact" />
				</section>
				<hr>
				<section id="now-prev">
					<NowPrev />
				</section>
			</article>
		</main>
    </body>
</html>