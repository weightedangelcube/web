---
import "../styles/index.scss"
---
<!doctype html>
<html lang="en-CA">
	<head>
		<!-- Important metadata, and the like -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width = device-width, initial-scale = 1" />
		<title>angelcube</title>

        <!-- Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg">
	</head>
    <body>
        <main>
			<header>
				<picture>
					<source srcset="/img/header-dark.png" media="(prefers-color-scheme: dark)">
					<img alt="A pixelated, artistic rendition of Angel. He has short, messy dark hair, round-framed 
							  glasses, and is wearing a cropped T-shirt, jacket, shorts, and sneakers. Above him is a 
							  melting halo, and behind him is a pair of angel wings. Four Angels in varying positions 
							  are depicted." src="/img/header-light.png">
				</picture>

				<div class="title">
					<h1>angelcube ✦</h1>
					<p>The digital garden of computer human Angel Wang. </p>
				</div>
				<nav>
					<ul>
						<li>
							<a href="/journal">Journal</a>
						</li>
						<li>
							<a href="/projects">Projects</a>
						</li>
						<li>
							<a href="/now">Now</a>
						</li>
						<li>
							<a href="/about">About</a>
						</li>
					</ul>
				</nav>
			</header>

			<section id="about">
				<article>
					<h2>about the author</h2>
					<p>
						Angel Wang <em>(he/she)</em> is a computer science student at the University of Toronto. He's a
						big fan of Arch Linux, TypeScript, CSS, and making the web a softer, more wholesome place.
					</p>
					<h3>NOW</h3>
					<a href="/now">Check out what she's been up to recently →</a>
				</article>
				<picture>
					<source srcset="/img/laptop-dark.png" media="(prefers-color-scheme: dark)">
					<img alt="Angel lying on her front typing at a laptop." src="/img/laptop-light.png">
				</picture>
			</section>
		</main>
    </body>
</html>