---
const { title, description, navTitle = "← return home", navHref = "/" } = Astro.props

import "../styles/components/header.scss"
import Nav from "./Nav.astro"
---

<header>
	<Nav title={navTitle} href={navHref} />
	<div class="title">
		<h1>{title}</h1>
		<p class="description">{description}</p>
	</div>
</header>
